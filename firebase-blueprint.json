{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Student academic identity and enrollment record with APAAR identifier.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique student record ID",
          "maxLength": 128
        },
        "apaarId": {
          "type": "string",
          "description": "12-digit APAAR identification number",
          "minLength": 12,
          "maxLength": 14,
          "pattern": "^[0-9]{12}$"
        },
        "apaarMasked": {
          "type": "string",
          "description": "Masked display format of the APAAR identifier",
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "description": "Full student legal name",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Student primary or institution email address",
          "maxLength": 120
        },
        "program": {
          "type": "string",
          "description": "Academic program enrolled in",
          "minLength": 2,
          "maxLength": 100
        },
        "institution": {
          "type": "string",
          "description": "Enrolling institution name",
          "minLength": 2,
          "maxLength": 120
        },
        "institutionId": {
          "type": "string",
          "description": "Unique identifier of the institution",
          "maxLength": 64
        },
        "intakeYear": {
          "type": "number",
          "description": "Academic intake year (e.g. 2025, 2026)"
        },
        "status": {
          "type": "string",
          "description": "Validation and verification status",
          "enum": ["verified", "pending", "flagged", "incomplete"]
        },
        "completeness": {
          "type": "number",
          "description": "Percentage completeness of the student dossier (0-100)"
        },
        "submittedBy": {
          "type": "string",
          "description": "User UID who submitted this record",
          "maxLength": 128
        },
        "submittedByName": {
          "type": "string",
          "description": "Name or email of the submitter",
          "maxLength": 120
        },
        "isDuplicateCandidate": {
          "type": "boolean",
          "description": "Whether intelligent validation flagged a duplicate candidate"
        },
        "flagReason": {
          "type": "string",
          "description": "Explanation of flag or anomaly if present",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": [
        "apaarId",
        "name",
        "program",
        "institution",
        "intakeYear",
        "status",
        "submittedBy"
      ]
    },
    "Institution": {
      "title": "Institution",
      "description": "Academic institution metadata and approved intake capacity.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Institution code or slug",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "description": "Full formal institution name",
          "minLength": 3,
          "maxLength": 120
        },
        "approvedIntake": {
          "type": "number",
          "description": "Official AICTE / council approved seat intake"
        },
        "enrolledCount": {
          "type": "number",
          "description": "Current actual enrolled student records"
        },
        "verifiedCount": {
          "type": "number",
          "description": "Number of student records verified"
        },
        "location": {
          "type": "string",
          "description": "Geographical location or campus area",
          "maxLength": 150
        },
        "category": {
          "type": "string",
          "description": "Directory section category",
          "enum": [
            "Main Colleges",
            "Other Private Engineering Colleges",
            "Nearby Border-Area Colleges"
          ],
          "maxLength": 100
        },
        "collegeType": {
          "type": "string",
          "description": "Classification category such as Government-Aided, Autonomous, Private",
          "maxLength": 100
        },
        "district": {
          "type": "string",
          "description": "Administrative district or border region",
          "maxLength": 100
        },
        "verificationStatus": {
          "type": "string",
          "description": "Status indicating whether location or data was verified",
          "maxLength": 100
        },
        "verificationDetails": {
          "type": "string",
          "description": "Verification notes or details",
          "maxLength": 300
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["id", "name", "approvedIntake", "location", "category"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable audit trail event for verification and compliance traceability.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique audit log entry ID",
          "maxLength": 128
        },
        "action": {
          "type": "string",
          "description": "Audited action name",
          "maxLength": 64
        },
        "performedBy": {
          "type": "string",
          "description": "User UID who performed the action",
          "maxLength": 128
        },
        "performerEmail": {
          "type": "string",
          "description": "Email of user performing the action",
          "maxLength": 120
        },
        "targetStudentId": {
          "type": "string",
          "description": "ID of the affected student record",
          "maxLength": 128
        },
        "details": {
          "type": "string",
          "description": "Descriptive details of changes or verification note",
          "maxLength": 500
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of event occurrence"
        }
      },
      "required": ["action", "performedBy", "details", "timestamp"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with assigned RBAC role and institution affiliation.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Primary user email address",
          "maxLength": 120
        },
        "displayName": {
          "type": "string",
          "description": "User full display name",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "description": "Assigned access role",
          "enum": ["admin", "institution", "student"]
        },
        "institutionName": {
          "type": "string",
          "description": "Affiliated institution name for institutional users",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "description": "Account registration timestamp"
        }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of student academic identity and validation records"
    },
    "/institutions/{institutionId}": {
      "schema": "Institution",
      "description": "Collection of participating higher education institutions"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Append-only compliance audit trail"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Registered user accounts with role assignments"
    },
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "System administrative authority index for RBAC lookup"
    }
  }
}
